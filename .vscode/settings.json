{
  "cSpell.language": "en,pt,pt_BR",
  "files.exclude": {
    "**/*.aux": true,
    "**/*.bbl": true,
    "**/*.bcf": true,
    "**/*.blg": true,
    "**/*.fdb_latexmk": true,
    "**/*.fls": true,
    "**/*.lof": true,
    "**/*.lot": true,
    "**/*.log": true,
    "**/*.out": true,
    "**/*.run.xml": true,
    "**/*.synctex.gz": true,
    "**/*.toc": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },
  "latex-workshop.latex.tools": [
    { "name": "pp-pt", "command": "latexmk", "env": { "TEXINPUTS": ".;../../;" },
      "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "-pdf", "-outdir=%OUTDIR%", "-jobname=PreProjeto_MECAI_Felipe_Terrazas", "%DOC%"] },
    { "name": "pp-en", "command": "latexmk", "env": { "TEXINPUTS": ".;../../;" },
      "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "-pdf", "-outdir=%OUTDIR%", "-jobname=PreProjeto_MECAI_Felipe_Terrazas_EN", "%DOC%"] },
    { "name": "pp-pt-pb", "command": "latexmk", "env": { "TEXINPUTS": ".;../../;" },
      "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "-pdf", "-outdir=%OUTDIR%", "-jobname=PreProjeto_MECAI_Felipe_Terrazas_PB", "%DOC%"] },
    { "name": "pp-en-pb", "command": "latexmk", "env": { "TEXINPUTS": ".;../../;" },
      "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "-pdf", "-outdir=%OUTDIR%", "-jobname=PreProjeto_MECAI_Felipe_Terrazas_EN_PB", "%DOC%"] },
    { "name": "diss-pt", "command": "latexmk", "env": { "TEXINPUTS": ".;../../;" },
      "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "-pdf", "-outdir=%OUTDIR%", "-jobname=Dissertacao_MECAI_Felipe_Terrazas", "%DOC%"] },
    { "name": "diss-en", "command": "latexmk", "env": { "TEXINPUTS": ".;../../;" },
      "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "-pdf", "-outdir=%OUTDIR%", "-jobname=Dissertacao_MECAI_Felipe_Terrazas_EN", "%DOC%"] },
    { "name": "diss-pt-pb", "command": "latexmk", "env": { "TEXINPUTS": ".;../../;" },
      "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "-pdf", "-outdir=%OUTDIR%", "-jobname=Dissertacao_MECAI_Felipe_Terrazas_PB", "%DOC%"] },
    { "name": "diss-en-pb", "command": "latexmk", "env": { "TEXINPUTS": ".;../../;" },
      "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "-pdf", "-outdir=%OUTDIR%", "-jobname=Dissertacao_MECAI_Felipe_Terrazas_EN_PB", "%DOC%"] }
  ],
  "latex-workshop.latex.recipes": [
    { "name": "Pré-projeto: PT + EN, cor", "tools": ["pp-pt", "pp-en"] },
    { "name": "Pré-projeto: PT + EN, P&B", "tools": ["pp-pt-pb", "pp-en-pb"] },
    { "name": "Pré-projeto: todas as versões", "tools": ["pp-pt", "pp-en", "pp-pt-pb", "pp-en-pb"] },
    { "name": "Pré-projeto: só PT, cor", "tools": ["pp-pt"] },
    { "name": "Dissertação: PT + EN, cor", "tools": ["diss-pt", "diss-en"] },
    { "name": "Dissertação: PT + EN, P&B", "tools": ["diss-pt-pb", "diss-en-pb"] },
    { "name": "Dissertação: todas as versões", "tools": ["diss-pt", "diss-en", "diss-pt-pb", "diss-en-pb"] },
    { "name": "Dissertação: só PT, cor", "tools": ["diss-pt"] }
  ],
  "latex-workshop.latex.recipe.default": "lastUsed",
  "latex-workshop.latex.outDir": "%DIR%/output",
  "latex-workshop.view.pdf.viewer": "tab"
}
