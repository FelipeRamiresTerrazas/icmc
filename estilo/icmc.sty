\ifpretoebranco
  \definecolor{destaque}{gray}{0}
  \definecolor{cinzatexto}{gray}{0.2}
  \definecolor{fundonota}{gray}{0.95}
  \colorlet{pendencia}{black!65}
\else
  \definecolor{destaque}{HTML}{1F3A5F}
  \definecolor{cinzatexto}{HTML}{333333}
  \definecolor{fundonota}{HTML}{F2F5F9}
