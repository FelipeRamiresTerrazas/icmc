\onehalfspacing
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{0pt}
\setlist{itemsep=2pt,topsep=4pt}

\titleformat{\section}{\bfseries\color{destaque}\large\MakeUppercase}{\thesection}{8pt}{}
\titleformat{\subsection}{\bfseries\color{destaque}\normalsize}{\thesubsection}{6pt}{}
\titleformat{\subsubsection}{\bfseries\itshape\normalsize}{\thesubsubsection}{6pt}{}
\titlespacing*{\section}{0pt}{18pt}{8pt}
\titlespacing*{\subsection}{0pt}{12pt}{6pt}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\small\color{cinzatexto}\thepage}
\renewcommand{\headrulewidth}{0pt}

\newtcolorbox{nota}[1][\tr{Nota}{Note}]{
  colback=fundonota, colframe=destaque, boxrule=0.5pt, arc=1pt,
  left=6pt,right=6pt,top=4pt,bottom=4pt,
  fonttitle=\bfseries\small, fontupper=\small, title=#1
}

% Pendencias visiveis (somem do texto final quando todas forem resolvidas)
\ifpretoebranco
  \newcommand{\preencher}[1]{\textcolor{pendencia}{\itshape[#1]}}
\else
  \newcommand{\preencher}[1]{\textcolor{pendencia}{[#1]}}
\fi

% Referencias com note = CONFERIR aparecem na cor de pendencia
\DeclareFieldFormat{note}{\textcolor{pendencia}{#1}}
\AtEveryCitekey{\iffieldundef{note}{}{\color{pendencia}}}

\hypersetup{
  colorlinks=true, linkcolor=destaque, citecolor=destaque, urlcolor=destaque,
  pdfauthor={Felipe Ramires Terrazas}
}

