\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{estilo/icmc}[2026/11/08 Estilo bilingue do pre-projeto ICMC (MECAI)]

% Estilo proprio do pre-projeto ICMC. Copia o visual do estilo/mestrado.sty
% (Times 12 pt, entrelinha 1,5, margens 3/2 cm) sem altera-lo, e acrescenta
% o modo bilingue.
%
% Lingua escolhida pelo nome do PDF de saida (-jobname):
%   termina em _EN ou _EN_PB  -> ingles
%   qualquer outro            -> portugues
% Preto e branco: termina em _PB (ou _EN_PB).
%
% Comandos de texto:
%   \pt{...} e \en{...}  paragrafos inteiros, um logo abaixo do outro
%   \tr{pt}{en}          trechos curtos (titulos, celulas de tabela, legendas)

\newif\ifingles
\newif\ifpretoebranco
\ExplSyntaxOn
\str_if_eq:eeT { \str_range:Nnn \c_sys_jobname_str { -3 } { -1 } } { _EN }
  { \inglestrue }
\str_if_eq:eeT { \str_range:Nnn \c_sys_jobname_str { -6 } { -1 } } { _EN_PB }
  { \inglestrue }
\str_if_eq:eeT { \str_range:Nnn \c_sys_jobname_str { -3 } { -1 } } { _PB }
  { \pretoebrancotrue }
\ExplSyntaxOff
\ifdefined\forcaringles \inglestrue \fi

\newcommand{\tr}[2]{\ifingles#2\else#1\fi}
\newcommand{\pt}[1]{\ifingles\else#1\fi}
\newcommand{\en}[1]{\ifingles#1\fi}

% Figuras: \includegraphics{\arqfig{nome}} escolhe o arquivo pela lingua e pelo
% modo, como \tr faz com o texto. Cada figura existe em quatro arquivos, gerados
% pelos scripts (analise/estilo_fig.py e r/estilo_fig.R):
%   nome.pdf (PT, cor), nome_en.pdf (EN, cor), nome_pb.pdf (PT, P&B), nome_en_pb.pdf (EN, P&B)
\newcommand{\arqfig}[1]{#1\ifingles _en\fi\ifpretoebranco _pb\fi}
% Trechos de legenda que citam cores: \corpb{versao colorida}{versao P&B}
\newcommand{\corpb}[2]{\ifpretoebranco#2\else#1\fi}

